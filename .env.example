# ------------------------------------------------------------------
# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die Datei ".env" steht in .gitignore und wird NIEMALS committet!
# ------------------------------------------------------------------

# Dein Mistral-API-Key (kostenlos anlegen: https://console.mistral.ai/)
# Ohne Key laufen alle Übungen automatisch im OFFLINE-Modus (keine Kosten).
MISTRAL_API_KEY=

# Optional: Modellname, wenn du ein anderes Mistral-Modell testen willst.
# Standard in den Lösungen: mistral-small-latest
ACADEMY_MODEL=mistral-small-latest

# Optional: Offlinemodus erzwingen ("1" = immer offline, auch wenn ein Key existiert)
ACADEMY_OFFLINE=

# Beispiel für eine eigene Umgebungsvariable (Aufgabe 1.4)
BEISPIEL_NAME=Dein Name
