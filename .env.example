# =====================================================================
# Lernakademie – zentrale KI-Konfiguration
# Kopiere diese Datei zu ".env" und trage NUR Platzhalter ein.
# Die echte .env wird NIEMALS committet (siehe .gitignore).
# =====================================================================
# Die "Wo/Wie/Welche"-Regel:
#   LLM_BASE_URL -> WO lebt dein KI-Server?
#   LLM_API_KEY  -> WIE darfst du zugreifen? (bei lokalen Servern oft leer!)
#   LLM_MODEL    -> WELCHES Modell soll antworten?
#
# Verbindung testen nach Aenderungen:  python -m tools.test_llm_connection

# ---------- Variante A: Mistral Cloud (Standard-Beispiel der Akademie) ----------
# Kostenlosen Key anlegen: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ---------- Variante B: lokaler AI-Server / OpenAI-kompatibler Endpoint ----------
# Funktioniert mit LM Studio, Ollama (OpenAI-Endpoint), vLLM, LocalAI,
# llama.cpp-Server u. a. – pruefe die Doku deines Servers fuer die
# tatsaechliche URL und den Modellnamen!
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=dein-lokales-modell

# ---------- Feineinstellung (optional) ----------
# LLM_PROVIDER      # auto (Standard) | mistral | openai_compatible | offline
# ACADEMY_OFFLINE=1 # Offline-Modus erzwingen (auch mit Key)
# EMBEDDINGS=auto   # auto | openai_compatible (Embeddings-Endpoint des Servers)
# EMBEDDINGS_MODEL= # Modellname fuer den Embeddings-Endpoint

# Beispiel-Umgebungsvariable aus Modul 0 (Aufgabe 0.3)
BEISPIEL_NAME=Dein Name
