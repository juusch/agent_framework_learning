# ------------------------------------------------------------------
# Capstone-Konfiguration. Kopiere diese Datei zu ".env" (Projektordner
# final-project/knowledge-research-agent) und trage Werte ein.
# docker compose liest sie automatisch. Die echte .env wird NIE committet.
# ------------------------------------------------------------------

# Mistral-API-Key (https://console.mistral.ai/). Ohne Key: OFFLINE-Modus –
# alles laeuft, nur die LLM-Formulierungen sind simuliert.
MISTRAL_API_KEY=

# Modellname (Standard: mistral-small-latest)
ACADEMY_MODEL=mistral-small-latest

# Offline erzwingen ("1" = auch mit Key offline, z. B. fuer Demos)
ACADEMY_OFFLINE=

# Nur relevant, wenn docker compose mit echtem Neo4j genutzt wird:
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=lernakademie
