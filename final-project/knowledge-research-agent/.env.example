# ------------------------------------------------------------------
# Capstone-Konfiguration. Kopiere diese Datei zu ".env" (Projektordner
# final-project/knowledge-research-agent) und trage Werte ein.
# docker compose liest sie automatisch. Die echte .env wird NIE committet.
# ------------------------------------------------------------------

# Die finale Anwendung nutzt DIESELBE zentrale Konfiguration wie die
# ganze Akademie (lernakademie/config.py). Verbindung testen:
#   python -m tools.test_llm_connection
#
# Variante A: Mistral Cloud
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Variante B: lokaler AI-Server (OpenAI-kompatibel) – einfach einkommentieren:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=dein-lokales-modell

# Modellname (Standard: mistral-small-latest)
ACADEMY_MODEL=mistral-small-latest

# Offline erzwingen ("1" = auch mit Key offline, z. B. fuer Demos)
ACADEMY_OFFLINE=

# Nur relevant, wenn docker compose mit echtem Neo4j genutzt wird:
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=lernakademie
